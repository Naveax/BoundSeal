{
  "schema_version": 1,
  "passive_only": true,
  "maximum_depth": 2,
  "maximum_endpoints": 256,
  "maximum_requests": 128,
  "maximum_body_bytes": 2097152,
  "follow_redirects": false,
  "allow_session_mutation": false,
  "probe_capabilities": [
    "security_headers",
    "cookie_flags",
    "cors",
    "cache_policy",
    "redirect_safety",
    "tls_metadata"
  ]
}
